# Copy to .env and replace every placeholder. Never commit .env.
# CATALOG_HOST is a plain DNS name without a protocol or path.
CATALOG_HOST=catalog.example.org
ACME_EMAIL=researcher@example.org
CATALOG_MODE=http-demo
CATALOG_PUBLIC_URL=https://catalog.example.org
CATALOG_CORS_ORIGINS=
CATALOG_MAX_INGEST_BYTES=2097152
CATALOG_STARTUP_WAIT_SECONDS=60

# Generate two independent values with: openssl rand -hex 32
# The catalog derives graph ownership from the bearer token. These are demo
# credentials for the simulated HTTP adapter, not Eclipse EDC/DSP credentials.
EDC_DEMO_PARTICIPANTS={"urn:demo:participant:a":"REPLACE_WITH_64_HEX_TOKEN_A","urn:demo:participant:b":"REPLACE_WITH_64_HEX_TOKEN_B"}

FUSEKI_URL=http://fuseki:3030/catalog
FUSEKI_USER=admin
FUSEKI_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
FUSEKI_TIMEOUT_SECONDS=10

SPARQL_MAX_REQUEST_BYTES=32768
SPARQL_MAX_ROWS=500
SPARQL_MAX_RESPONSE_BYTES=2097152
SPARQL_TIMEOUT_SECONDS=10
