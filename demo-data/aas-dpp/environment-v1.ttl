<https://example.org/aas-dpp/catalogs/environment> a dcat:Catalog ;
  dct:title "Environment catalog"@en ;
  dcat:contactPoint <https://example.org/aas-dpp/contacts/environment> ;
  dcat:dataset <https://example.org/aas-dpp/datasets/environment> .

<https://example.org/aas-dpp/datasets/environment> a dcat:Dataset, cx:AASDataset ;
