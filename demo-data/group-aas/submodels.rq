PREFIX cx: <https://w3id.org/construct-dcat#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT DISTINCT ?graph ?dataset ?title ?submodel ?asset ?shell ?semanticType ?access
WHERE {
  GRAPH ?graph {
    <urn:tmdt:aas-demo:catalog> dcat:dataset ?dataset .
    ?dataset a cx:AASDataset ; dct:title ?title ;
      cx:hasAASSubmodel ?submodel ; dcat:distribution ?distribution .
    ?distribution dcat:accessURL ?access .
    OPTIONAL { ?dataset dct:subject ?asset }
    OPTIONAL { ?submodel dct:isPartOf ?shell }
    OPTIONAL { ?submodel dct:type ?semanticType }
  }
}
ORDER BY ?title
