PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT DISTINCT ?graphA ?catalogA ?datasetA ?titleA
                ?graphB ?catalogB ?datasetB ?titleB
WHERE {
  GRAPH ?graphB {
    ?catalogB a dcat:Catalog ; dcat:dataset ?datasetB .
    ?datasetB a dcat:Dataset ;
              dct:title ?titleB ;
              dct:relation ?datasetA .
  }
  GRAPH ?graphA {
    ?catalogA a dcat:Catalog ; dcat:dataset ?datasetA .
    ?datasetA a dcat:Dataset ; dct:title ?titleA .
  }
  FILTER (?graphA != ?graphB)
}
ORDER BY ?titleA ?titleB
